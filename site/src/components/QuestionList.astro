---
import { category, sub, mmss, type Question, url } from '../lib/data';

interface Props { items: Question[]; showSub?: boolean }
const { items, showSub = false } = Astro.props;
---
{items.length === 0 ? (
  <p class="empty-note">No questions here yet.</p>
) : (
  <ul class="q-list">
    {items.map((q) => (
      <li class="q-item card">
        <div class="meta">
          <a class="chip" href={url(`/category/${q.category}/${showSub ? q.subcategory + '/' : ''}`)}>
            {showSub ? sub(q.category, q.subcategory).name : category(q.category).name}
          </a>
          <a class="chip plain" href={url(`/video/${q.videoId}/`)} title={q.video.title}>▶ {mmss(q.start)}</a>
        </div>
        <h3><a href={url(`/q/${q.slug}/`)}>{q.question}</a></h3>
        <p>{q.excerpt}</p>
      </li>
    ))}
  </ul>
)}

---
interface Props { autofocus?: boolean }
const { autofocus = false } = Astro.props;
---
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="search" data-autofocus={autofocus ? '1' : undefined}>
  <noscript><p class="search-fallback">Search needs JavaScript. Browse by <a href="/category/">topic</a> instead.</p></noscript>
</div>
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  (() => {
    const el = document.getElementById('search');
    if (typeof PagefindUI === 'undefined') {
      el.insertAdjacentHTML('beforeend', '<p class="search-fallback">Search index not built (run <code>npm run build</code>).</p>');
      return;
    }
    new PagefindUI({
      element: '#search',
      showImages: false,
      showSubResults: false,
      resetStyles: false,
      excerptLength: 26,
      translations: { placeholder: 'Search questions, e.g. organ donation, madhhab, crypto…' },
    });
    const q = new URLSearchParams(location.search).get('q');
    const input = el.querySelector('input');
    if (input && q) { input.value = q; input.dispatchEvent(new Event('input')); }
    if (input && el.dataset.autofocus) input.focus();
  })();
</script>

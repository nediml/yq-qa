---
import '../styles/global.css';
import { url } from '../lib/data';

interface Props { title?: string; description?: string; section?: string }
const { title, description, section } = Astro.props;
const siteName = 'YQ Q&A';
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — Questions answered by Shaykh Dr. Yasir Qadhi`;
const desc = description ?? 'An unofficial, searchable archive of questions answered by Shaykh Dr. Yasir Qadhi in his Q&A sessions, each linked to the exact moment in the video.';
const nav = [
  { href: '/category/', label: 'Topics', key: 'topics' },
  { href: '/series/', label: 'Series', key: 'series' },
  { href: '/saved/', label: 'Saved', key: 'saved' },
  { href: '/about/', label: 'About', key: 'about', hideSm: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={desc} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <meta name="theme-color" content="#0d6b57" />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('yqqa.theme'); } catch {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url("/")}>
          <span class="brand-mark">YQ <span>Q&amp;A</span></span>
          <span class="brand-sub">Unofficial archive of Shaykh Dr. Yasir Qadhi's answers</span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={url(n.href)} class={n.hideSm ? 'hide-sm' : undefined} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={url("/search/")} aria-label="Search" title="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href={url("/")}>Home</a>
          <a href={url("/category/")}>Topics</a>
          <a href={url("/series/")}>Series</a>
          <a href={url("/saved/")}>Saved</a>
          <a href={url("/about/")}>About</a>
        </nav>
        <p style="margin:0">
          Unofficial fan archive. Not affiliated with Shaykh Dr. Yasir Qadhi, EPIC Masjid or Memphis Islamic Center.
          Answers are edited transcripts. The linked video is always the source.
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('yqqa.theme', next); } catch {}
      });
    </script>
  </body>
</html>

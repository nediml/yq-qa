---
import Base from '../../layouts/Base.astro';
import { videos, inVideo, sub, mmss, formatDate, ytUrl, type Video } from '../../lib/data';

export function getStaticPaths() {
  return [...videos.values()].map((v) => ({ params: { id: v.id }, props: { v } }));
}
const { v } = Astro.props as { v: Video };
const qs = inVideo(v.id);
---
<Base title={v.title} section="series">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Home</a><span aria-hidden="true">›</span>
    <a href="/series/">Series</a>
    {v.playlist && <><span aria-hidden="true">›</span><a href={`/series/${v.playlist.id}/`}>{v.playlist.title}</a></>}
  </nav>
  <div class="v-head">
    <h1>{v.title}</h1>
    <p class="muted" style="margin:0">
      {v.channel} · {formatDate(v.uploadDate)} · {mmss(v.duration)} ·{' '}
      <a href={ytUrl(v.id)} target="_blank" rel="noopener">Watch on YouTube</a>
    </p>
  </div>

  <h2>{qs.length} {qs.length === 1 ? 'question' : 'questions'} in this session</h2>
  {qs.length === 0 ? <p class="empty-note">This video hasn't been processed yet.</p> : (
    <ol class="ts-list">
      {qs.map((q) => (
        <li class="card">
          <a class="ts" href={ytUrl(v.id, q.start)} target="_blank" rel="noopener" title="Open on YouTube at this moment">▶ {mmss(q.start)}</a>
          <div>
            <a class="q" href={`/q/${q.slug}/`}>{q.question}</a>
            <div class="muted" style="font-size:0.85rem">{sub(q.category, q.subcategory).name}</div>
          </div>
        </li>
      ))}
    </ol>
  )}
</Base>
